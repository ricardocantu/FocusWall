# Copy to .env (gitignored) on the Pi and fill in. docker-compose reads .env
# automatically for ${VAR} interpolation in docker-compose.yml.

# Required to enable Discord notifications. Without it, DiscordNotifier
# self-disables at startup and logs a single info line — the dashboard and
# every other channel are unaffected. Treat this URL like a password; anyone
# with it can post to your channel.
DISCORD_WEBHOOK_URL=

# Optional. If set, the embed becomes clickable and opens the dashboard.
# Only reachable while your phone is on the same LAN as the Pi.
# DISCORD_DASHBOARD_URL=http://focus-wall.local:5050/

# Optional overrides (defaults live in docker-compose.yml):
# DISCORD_COOLDOWN_SECONDS=120   # min gap between notifications for the SAME session
# DISCORD_QUIET_START=22:00      # HH:MM; suppress window start (container-local time via TZ)
# DISCORD_QUIET_END=07:30        # HH:MM; suppress window end
