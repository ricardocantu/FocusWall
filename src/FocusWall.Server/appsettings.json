{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // The HttpClient factory logs "Start processing HTTP request GET <url>" at
      // Information for every outbound call — which would put each secret ICS
      // URL and the Voice Monkey ?token= URL in the container log (and, on a
      // failed deploy, in the Actions log). Warning keeps real failures only.
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Rss": {
    // TOP ticker — news, economy, business, science, technology.
    "NewsFeeds": [
      "https://feeds.npr.org/1014/rss.xml",             // NPR — Politics
      "https://feeds.npr.org/1017/rss.xml",             // NPR — Economy
      "https://feeds.npr.org/1006/rss.xml",             // NPR — Business
      "https://feeds.npr.org/1007/rss.xml",             // NPR — Science
      "https://feeds.npr.org/1019/rss.xml",             // NPR — Technology
      "https://feeds.bbci.co.uk/news/rss.xml",          // BBC — Top News
      "https://feeds.bbci.co.uk/news/business/rss.xml", // BBC — Business
      "https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml", // NYT — Top Stories
      "https://rss.nytimes.com/services/xml/rss/nyt/Business.xml", // NYT — Business
      "https://feeds.marketwatch.com/marketwatch/topstories/",     // MarketWatch — Top Stories (WSJ sibling; WSJ has no working RSS)
      "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10001147" // CNBC — Business
    ],
    // BOTTOM ticker — sports.
    "SportsFeeds": [
      "https://feeds.npr.org/1055/rss.xml",             // NPR — Sports
      "https://www.espn.com/espn/rss/news",             // ESPN — Top Sports
      "https://www.espn.com/espn/rss/nfl/news",         // ESPN — NFL
      "https://www.espn.com/espn/rss/mlb/news",         // ESPN — MLB
      "https://www.espn.com/espn/rss/soccer/news",      // ESPN — Soccer (all leagues)
      "https://www.espn.com/espn/rss/f1/news"           // ESPN — Formula 1
    ],
    "RefreshMinutes": 10,
    // Max items per ticker (applied to each group independently).
    "MaxItems": 40
  },
  "Slack": {
    // Session-token workspaces for the unread chip. Empty here — real tokens
    // (xoxc + d cookie) arrive via GH Actions secrets → docker-compose env
    // (Slack__Workspaces__N__*). Empty ⇒ SlackService self-disables, chip hidden.
    // See SLACK_SETUP_CHECKLIST.md.
    "Workspaces": [],
    "RefreshSeconds": 60
  },
  "Calendar": {
    // Secret iCal feed URLs, one per calendar. Empty here — real URLs arrive
    // via GH Actions secrets → docker-compose env (Calendar__Sources__N__*).
    // Empty ⇒ CalendarService self-disables, pane hidden.
    // See CALENDAR_SETUP_CHECKLIST.md.
    "Sources": [],
    "RefreshMinutes": 15
  },
  "AllowedHosts": "*"
}
